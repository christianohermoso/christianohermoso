{
  "name": "christiano-heromoso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-sanity.mjs",
    "images": "node scripts/generate-images.mjs",
    "predev": "npm run images",
    "dev": "next dev",
    "prebuild": "npm run sync && npm run images",
    "build": "next build",

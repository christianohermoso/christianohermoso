    "studio:deploy": "npm --prefix studio run deploy",
    "migrate": "node scripts/migrate-to-sanity.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@sanity/client": "^8.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "ffmpeg-static": "^5.3.0",
    "lexorank": "^1.0.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  }
